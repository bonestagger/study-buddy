# ========================================================
# ICSE Grade 8 ClassNotes Hub - Environment Variables
# ========================================================

# 1. Database Connection URL
# For local SQLite development:
DATABASE_URL="file:./dev.db"

# For Vercel Production (Neon / Supabase / Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 2. NextAuth Configuration
# Run `openssl rand -base64 32` or use any random 32-character string
NEXTAUTH_SECRET="your-super-secret-random-key-here-32-chars"

# For production, set this to your Vercel URL (e.g. https://your-project.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
